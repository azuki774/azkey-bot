MISSKEY_BASE_URL=https://misskey.example.invalid
MISSKEY_TOKEN=replace-with-a-local-token
LOG_LEVEL=INFO
POLL_INTERVAL=1m
FOLLOWER_SYNC_INTERVAL=10m
FOLLOW_WRITE_INTERVAL=1m
FOLLOW_MAX_WRITES_PER_SYNC=10
POLL_CONCURRENCY=2
POLL_RATE_PER_SECOND=2
POLL_RATE_BURST=1
POLL_PAGE_LIMIT=100
POLL_MAX_PAGES_PER_TURN=5
POLL_DEDUP_LIMIT=10000
POLL_DEDUP_TTL=24h
POLL_STARTUP_SPREAD=1m
POLL_BACKOFF_BASE=1s
POLL_BACKOFF_MAX=5m

# User check-in state only. Poll/reply cursors remain in memory.
# Set valkey to persist counts and the last check-in timestamp.
KVS_BACKEND=memory
# Set the following only when KVS_BACKEND=valkey.
# Unique to this environment + Misskey instance + bot; stable across redeploys.
# KVS_NAMESPACE=prod-azkey-roumu-bot
# rediss enables TLS with certificate verification; redis is plaintext.
# KVS_URL=rediss://valkey.example.invalid:6379
# KVS_USERNAME=default
# Inject from your deployment secret store; never commit actual credentials.
# KVS_PASSWORD=
# Alternatively mount a secret file; do not set both password sources.
# KVS_PASSWORD_FILE=/run/secrets/valkey_password
# KVS_DB=0
